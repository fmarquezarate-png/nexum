# Variables de la app móvil.
# Copia este archivo como ".env" en esta misma carpeta.
#
# IMPORTANTE: en Expo, solo las variables que empiezan por EXPO_PUBLIC_
# llegan al código de la app. Y "PUBLIC" significa PÚBLICO de verdad:
# cualquiera que descargue la app puede leerlas.
#
# Por eso aquí SOLO puede ir la clave pública (anon).
# La clave de servicio NUNCA, bajo ningún concepto.

EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
