{
  "expo": {
    "name": "Nexum",
    "slug": "nexum",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexum",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EFE6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nexum.mobile"
    },
    "android": {
      "package": "app.nexum.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2EFE6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "comentario": "Las claves de Supabase NO van aquí. Van en el archivo .env como EXPO_PUBLIC_*"
    }
  }
}
