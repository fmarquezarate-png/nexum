{
  "name": "nexum",
  "version": "0.1.0",
  "private": true,
  "description": "Nexum — Tu hogar, más simple. Monorepo de la app, el backend y los contratos.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "npm run start --workspace apps/mobile",
    "bridge": "npm run dev --workspace services/mqtt-bridge",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "typecheck": "tsc --noEmit -p tsconfig.base.json"
  }
}
