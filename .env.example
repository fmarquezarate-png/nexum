# ─────────────────────────────────────────────────────────────────────
#  Nexum — plantilla de variables de entorno
# ─────────────────────────────────────────────────────────────────────
#
#  Una "variable de entorno" es un dato de configuración (una clave, una
#  dirección) que NO se escribe dentro del código, porque es secreto o
#  porque cambia según dónde se ejecute la app.
#
#  CÓMO USAR ESTE ARCHIVO:
#    1. Haz una copia y llámala exactamente ".env"
#    2. Rellena los valores entre comillas
#    3. NUNCA subas el archivo ".env" a GitHub (ya está bloqueado
#       en .gitignore, pero conviene que lo sepas)
#
#  Cada carpeta que necesita variables tiene además su propio
#  .env.example: apps/mobile y services/mqtt-bridge.
# ─────────────────────────────────────────────────────────────────────


# ─── SUPABASE ────────────────────────────────────────────────────────
# Dónde se saca: https://supabase.com → tu proyecto →
#   Project Settings → API

# Dirección de tu proyecto. Parece una web y empieza por https://
SUPABASE_URL=""

# Clave PÚBLICA. Puede viajar dentro de la app del móvil sin peligro:
# por sí sola no da acceso a nada, porque las reglas de seguridad de la
# base de datos (RLS) filtran qué puede ver cada usuario.
SUPABASE_ANON_KEY=""

# Clave de SERVICIO. Esta SALTA todas las reglas de seguridad.
# Solo puede vivir en el servidor (services/mqtt-bridge y las Edge
# Functions). Si acaba dentro de la app del móvil, cualquiera puede
# leer y borrar toda la base de datos.
SUPABASE_SERVICE_ROLE_KEY=""


# ─── HIVEMQ CLOUD (broker MQTT) ──────────────────────────────────────
# Dónde se saca: https://console.hivemq.cloud → tu cluster →
#   Overview (la dirección) y Access Management (usuarios)

# Dirección del broker, del estilo: xxxxx.s1.eu.hivemq.cloud
MQTT_HOST=""

# Puerto con cifrado TLS. Para el servicio de Node es 8883.
MQTT_PORT="8883"

# Usuario y contraseña del servicio puente (mqtt-bridge).
# Cada dispositivo ESP32 tendrá SU PROPIO usuario distinto de este.
MQTT_BRIDGE_USERNAME=""
MQTT_BRIDGE_PASSWORD=""


# ─── OPCIONAL: CLIMA EXTERIOR ────────────────────────────────────────
# Para la tarjeta de temperatura exterior de la pantalla de Inicio.
# Fase 3. Déjalo vacío por ahora.
WEATHER_API_KEY=""
