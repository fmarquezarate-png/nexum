{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // Node 22+ ejecuta TypeScript directamente, pero exige la extensión .ts
    // en los imports. Estas dos opciones hacen que tsc lo acepte y que al
    // compilar se reescriba a .js.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
