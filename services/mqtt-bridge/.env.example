# Variables del servicio mqtt-bridge.
# Copia este archivo como ".env" en esta misma carpeta y rellénalo.
# Este servicio vive en un servidor, NO en el móvil: por eso aquí sí
# puede estar la clave de servicio.

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

MQTT_HOST=""
MQTT_PORT="8883"
MQTT_BRIDGE_USERNAME=""
MQTT_BRIDGE_PASSWORD=""

# Segundos que esperamos la confirmación de un dispositivo antes de
# dar el comando por perdido y marcarlo como 'timeout'.
COMMAND_TIMEOUT_SECONDS="30"
